# Copy this file to .env.local

# Leave as "true" to run the UI on its own built-in data.
# Set to "false" once the FastAPI backend is running to use real data.
NEXT_PUBLIC_USE_MOCK=true

# Your teammate's FastAPI address. Only used when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cognito. Leave these empty to use the built-in role picker instead of a real login.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=ap-south-1
